{
  "name": "breath-app-clean",
  "private": true,
  "version": "0.1.1",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdonyushko-source/bro.inhale.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.breathapp.clean",
    "productName": "bro.inhale",
    "artifactName": "bro.inhale-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.icns"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "sdonyushko-source",
      "repo": "bro.inhale",
      "releaseType": "draft"
    }
  }
}
